{
  "name": "Zu",
  "id": "dev.dspo.zu",
  "version": "0.1.0",
  "build": 1,
  "appearance": "system",
  "window": {
    "title": "Zu",
    "defaultSize": {
      "width": 1200,
      "height": 800
    },
    "minSize": {
      "width": 900,
      "height": 600
    },
    "titleBar": {
      "style": "hidden",
      "height": 48,
      "controlsOffset": {
        "x": 18,
        "y": 17
      }
    }
  },
  "theme": "theme.json",
  "rust": ".",
  "capabilities": {
    "network": {
      "hosts": [
        "127.0.0.1"
      ]
    },
    "process": {
      "env": [
        "ZU_PORT",
        "ZU_STATE_DIR"
      ]
    },
    "webview": {
      "hosts": [
        "*"
      ]
    },
    "statusBar": true
  }
}
