{
  "name": "Pi Desktop UI",
  "cssVars": {
    "theme": {
      "radius": "10px",
      "radius-card": "12px",
      "radius-control": "8px"
    },
    "light": {
      "background": "#ffffff",
      "web-page": "#ffffff",
      "foreground": "#1d1d1f",
      "card": "#ffffff",
      "card-foreground": "var(--foreground)",
      "popover": "#ffffff",
      "popover-foreground": "var(--foreground)",
      "primary": "#6d5ae0",
      "primary-foreground": "#ffffff",
      "secondary": "var(--raised)",
      "secondary-foreground": "var(--foreground)",
      "muted": "#f2f2f4",
      "muted-foreground": "#6e6e73",
      "accent": "#f1eefc",
      "accent-foreground": "#1d1d1f",
      "destructive": "#d93848",
      "border": "#dedee3",
      "input": "#d7d7dc",
      "ring": "#b8b0e8",
      "sidebar": "#fafafd",
      "sidebar-foreground": "var(--foreground)",
      "inset": "#f7f7f9",
      "raised": "#f6f6f8",
      "line": "#e4e4e8",
      "hover": "#f0f0f3",
      "faint": "#8b8b91",
      "up": "#1a8f5f",
      "warn": "#b26a00",
      "info": "#3d63d1",
      "brand": "#6d5ae0",
      "track": "#ececef",
      "knob": "#ffffff",
      "code": "#41424a",
      "scrollbar-thumb": "color-mix(in srgb, var(--muted-foreground) 50%, var(--background))",
      "scrollbar-thumb-hover": "color-mix(in srgb, var(--muted-foreground) 80%, var(--background))",
      "brand-tint": "rgba(109,90,224,0.12)",
      "scrim": "rgba(17,17,20,0.38)",
      "destructive-foreground": "#ffffff",
      "shadow": "rgba(20,18,40,0.08)",
      "shadow-strong": "rgba(20,18,40,0.14)",
      "shadow-inset": "rgba(20,18,40,0.06)",
      "toast": "#ffffff"
    },
    "dark": {
      "background": "#131316",
      "web-page": "#ffffff",
      "foreground": "#e8e8ea",
      "card": "#1b1b1f",
      "card-foreground": "var(--foreground)",
      "popover": "#1e1e23",
      "popover-foreground": "var(--foreground)",
      "primary": "#8b7cf6",
      "primary-foreground": "#14121c",
      "secondary": "var(--raised)",
      "secondary-foreground": "var(--foreground)",
      "muted": "#232327",
      "muted-foreground": "#a0a0a8",
      "accent": "#2a2340",
      "accent-foreground": "#f2f1f7",
      "destructive": "#ff6170",
      "border": "#2d2d33",
      "input": "#34343a",
      "ring": "#6e6e78",
      "sidebar": "#171719",
      "sidebar-foreground": "var(--foreground)",
      "inset": "#101013",
      "raised": "#202024",
      "line": "#26262b",
      "hover": "#202025",
      "faint": "#6f6f78",
      "up": "#45d49a",
      "warn": "#ffb547",
      "info": "#7ea8ff",
      "brand": "#a78bfa",
      "track": "#0e0e11",
      "knob": "#9a9da3",
      "code": "#d9dde3",
      "scrollbar-thumb": "color-mix(in srgb, var(--muted-foreground) 50%, var(--background))",
      "scrollbar-thumb-hover": "color-mix(in srgb, var(--muted-foreground) 80%, var(--background))",
      "brand-tint": "rgba(167,139,250,0.16)",
      "scrim": "rgba(0,0,0,0.55)",
      "destructive-foreground": "#14121c",
      "shadow": "rgba(0,0,0,0.40)",
      "shadow-strong": "rgba(0,0,0,0.55)",
      "shadow-inset": "rgba(0,0,0,0.35)",
      "toast": "#1e1e23"
    }
  }
}
