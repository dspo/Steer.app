{
  "name": "Pi Desktop UI",
  "cssVars": {
    "theme": {
      "radius": "8px",
      "radius-card": "12px",
      "radius-control": "7px"
    },
    "light": {
      "background": "#f7f7f8",
      "foreground": "#17171a",
      "card": "#ffffff",
      "card-foreground": "var(--foreground)",
      "popover": "#fafafa",
      "popover-foreground": "var(--foreground)",
      "primary": "#6d5ae0",
      "primary-foreground": "#ffffff",
      "secondary": "var(--raised)",
      "secondary-foreground": "var(--foreground)",
      "muted": "#eeeeef",
      "muted-foreground": "#6f6f76",
      "accent": "#ececed",
      "accent-foreground": "var(--foreground)",
      "destructive": "#d43a4a",
      "border": "#d9d9dc",
      "input": "#c9c9cd",
      "ring": "#a3a3ac",
      "sidebar": "#f0f0f2",
      "sidebar-foreground": "var(--foreground)",
      "inset": "#f1f1f3",
      "raised": "#f3f3f5",
      "line": "#e5e5e8",
      "hover": "#f5f5f6",
      "faint": "#9a9aa0",
      "up": "#138a5a",
      "warn": "#b26a00",
      "info": "#3d63d1",
      "brand": "#6d5ae0",
      "track": "#e9e9ec",
      "knob": "#ffffff",
      "code": "#2a2d33",
      "scrollbar-thumb": "color-mix(in srgb, var(--muted-foreground) 50%, var(--background))",
      "scrollbar-thumb-hover": "color-mix(in srgb, var(--muted-foreground) 80%, var(--background))",
      "brand-tint": "color-mix(in srgb, var(--brand) 16%, transparent)",
      "scrim": "rgba(0,0,0,0.45)",
      "destructive-foreground": "#ffffff"
    },
    "dark": {
      "background": "#131316",
      "foreground": "#e8e8ea",
      "card": "#1b1b1f",
      "card-foreground": "var(--foreground)",
      "popover": "#1e1e23",
      "popover-foreground": "var(--foreground)",
      "primary": "#8b7cf6",
      "primary-foreground": "#14121c",
      "secondary": "var(--raised)",
      "secondary-foreground": "var(--foreground)",
      "muted": "#222226",
      "muted-foreground": "#a0a0a8",
      "accent": "#26262b",
      "accent-foreground": "var(--foreground)",
      "destructive": "#ff6170",
      "border": "#2a2a2f",
      "input": "#333338",
      "ring": "#6e6e78",
      "sidebar": "#17171a",
      "sidebar-foreground": "var(--foreground)",
      "inset": "#161619",
      "raised": "#202024",
      "line": "#26262a",
      "hover": "#202025",
      "faint": "#6a6a72",
      "up": "#45d49a",
      "warn": "#ffb547",
      "info": "#7ea8ff",
      "brand": "#a78bfa",
      "track": "#0e0e11",
      "knob": "#9a9da3",
      "code": "#d9dde3",
      "scrollbar-thumb": "color-mix(in srgb, var(--muted-foreground) 50%, var(--background))",
      "scrollbar-thumb-hover": "color-mix(in srgb, var(--muted-foreground) 80%, var(--background))",
      "brand-tint": "color-mix(in srgb, var(--brand) 16%, transparent)",
      "scrim": "rgba(0,0,0,0.5)",
      "destructive-foreground": "#14121c"
    }
  }
}
