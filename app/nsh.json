{
  "name": "Zu",
  "id": "dev.dspo.zu",
  "version": "0.1.0",
  "build": 1,
  "appearance": "system",
  "window": {
    "title": "Zu",
    "defaultSize": {
      "width": 1200,
      "height": 800
    },
    "minSize": {
      "width": 900,
      "height": 600
    },
    "titleBar": {
      "style": "hidden",
      "height": 36,
      "controlsOffset": {
        "x": 18,
        "y": 11
      }
    },
    "closeOnPress": false
  },
  "theme": "theme.json",
  "rust": [
    "../native",
    "../native/manox"
  ],
  "capabilities": {
    "process": {
      "env": [
        "ZU_PORT",
        "ZU_STATE_DIR",
        "MANOX_RUN_LIVE",
        "ZU_SKIP_LIVE",
        "ZU_MANOX_GATE"
      ]
    },
    "webview": {
      "hosts": [
        "*"
      ]
    },
    "notifications": true,
    "statusBar": true,
    "openUrl": {
      "schemes": [
        "vscode"
      ]
    }
  }
}
